 {ball:[46,1],arrows:[['shot',36,22,46,1.5]],text:'Удар с 11-метровой отметки.',focus:['p10']}
 ]},
{id:'center',g:'С мячом',title:'Атака через центр',tag:'Атака 3-3-1',shape:'3-3-1',start:A,ball:'p95',opp:OD,
 intro:'Самад уводит защитника, мяч идёт через «третьего игрока», вингеры забегают за спину.',
 notes:{when:['Их центральный защитник выходит за Самадом.','Фланги закрыты.'],calls:['Человек!','Время!'],
  bad:['Самад разворачивается с защитником на спине.','Пас в центр, когда там трое соперников.','Вингеры стоят на месте и не забегают.']},
 steps:[
 {ball:'p9',arrows:[['pass',50,70,50,48]],text:'Анвар — Асланбеку. До приёма Асланбек смотрит через плечо.',focus:['p95','p9']},
 {pos:{p5:[50,32],p10:[28,28],p11:[72,28]},ball:'p5',opp:[[50,4],[28,18],[50,28],[72,18],[26,36],[46,38],[74,36],[54,54]],
  arrows:[['run',50,20,50,32],['pass',50,48,50,33],['run',12,40,28,28],['run',88,40,72,28]],
  text:'Самад опускается, их центральный идёт за ним, и за его спиной открывается место. Умар и Джабраил сужаются в полуфланги.',focus:['p5','p9','p10','p11']},
 {pos:{p9:[50,41],p11:[66,20]},ball:'p9',arrows:[['pass',50,32,50,41],['run',50,48,50,41],['run',72,28,66,20]],
  text:'Сброс назад на набегающего Асланбека, он получает лицом к воротам. Это «третий игрок»: защита не успевает перестроиться.',focus:['p5','p9','p11']},
 {pos:{p11:[62,12],p10:[36,12],p5:[48,18]},ball:'p11',opp:[[50,4],[30,14],[52,24],[66,16],[28,32],[46,36],[72,30],[54,52]],
  arrows:[['pass',50,41,62,12],['run',66,20,62,12],['run',28,28,36,12],['run',50,32,48,18]],
