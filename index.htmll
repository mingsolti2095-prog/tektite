<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Тактика 4-2-1 / 3-3-1</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=Unbounded:wght@600;700&display=swap">
<style>
/* Layout: тактическая доска слева, сценарий и установки справа, роли и план на матч ниже */
:root{
  --bg:#f2f4f1; --surface:#ffffff; --ink:#17201a; --muted:#5b685f; --line:#dbe2dc;
  --accent:#2557d6; --accent-soft:#e3eafc; --bad:#b42318; --good:#1f7a3a;
  --grass:#2f8f23; --grass2:#2a8420;
  --f-display:"Unbounded","Golos Text",system-ui,sans-serif;
  --f-body:"Golos Text",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0f1411; --surface:#171e19; --ink:#e6ece7; --muted:#93a198; --line:#2a342d;
  --accent:#7097ff; --accent-soft:#1d2740; --bad:#f97066; --good:#5fd58a; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f1411; --surface:#171e19; --ink:#e6ece7; --muted:#93a198; --line:#2a342d;
  --accent:#7097ff; --accent-soft:#1d2740; --bad:#f97066; --good:#5fd58a; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:13px;line-height:1.45;padding-inline:16px}
.wrap{max-width:1080px;margin:0 auto;padding-block:18px 48px;display:flex;flex-direction:column;gap:18px}
header{display:flex;flex-direction:column;gap:4px}
h1{font-family:var(--f-display);font-size:17px;margin:0;letter-spacing:-.01em;text-wrap:balance}
.sub{color:var(--muted);font-size:12px;margin:0;max-width:75ch}
.groups{display:flex;flex-direction:column;gap:8px}
.grp{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.grp .gl{font:600 10.5px var(--f-body);text-transform:uppercase;letter-spacing:.08em;color:var(--muted);width:92px;flex:none}
@media (max-width:520px){.grp .gl{width:100%}}
.chip{font:500 12px var(--f-body);padding:6px 11px;border-radius:999px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
.chip:focus-visible,button:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.main{display:grid;grid-template-columns:minmax(0,440px) minmax(0,1fr);gap:22px;align-items:start}
@media (max-width:780px){.main{grid-template-columns:minmax(0,1fr)}}
.board{display:flex;flex-direction:column;gap:10px;min-width:0}
.pitch{position:relative;width:100%;max-width:440px;aspect-ratio:68/100;border-radius:10px;overflow:hidden;
  background:repeating-linear-gradient(180deg,var(--grass) 0 10%,var(--grass2) 10% 20%)}
.pitch svg{position:absolute;inset:0;width:100%;height:100%}
.pl{position:absolute;transform:translate(-50%,-12px);display:flex;flex-direction:column;align-items:center;
  background:none;border:0;padding:0;cursor:pointer;z-index:3;
  transition:left 1.1s ease-in-out,top 1.1s ease-in-out,opacity .35s}
.pl .c{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;color:#fff;font:700 10.5px var(--f-body);
  background:linear-gradient(180deg,#4d86ff,#2453cf);border:2px solid #fff;box-shadow:0 1px 3px rgba(0,0,0,.35)}
.pl.gk .c{background:linear-gradient(180deg,#ffb534,#e08a00)}
.pl .n{font:600 9px var(--f-body);color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.75);white-space:nowrap;margin-top:1px}
.pl.dim{opacity:.45}
.pl.sel .c{box-shadow:0 0 0 3px #ffd23f}
.opp{position:absolute;width:15px;height:15px;border-radius:50%;background:#d93535;border:1.5px solid #fff;
  transform:translate(-50%,-50%);z-index:2;transition:left 1.1s ease-in-out,top 1.1s ease-in-out}
.opp.gk{background:#3a0d0d;border-color:#ff9b9b}
.ball{position:absolute;font-size:12px;line-height:1;transform:translate(-50%,-50%);z-index:4;
  transition:left .9s ease-in-out,top .9s ease-in-out}
.ball.held{transform:translate(3px,1px)}
.notrans .pl,.notrans .opp,.notrans .ball{transition:none!important}
.shape{position:absolute;left:8px;bottom:8px;z-index:5;font:700 11px var(--f-display);color:#fff;background:rgba(0,0,0,.38);padding:4px 8px;border-radius:6px;letter-spacing:.03em}
.dir{position:absolute;right:8px;bottom:8px;z-index:5;font:600 9.5px var(--f-body);color:#fff;background:rgba(0,0,0,.3);padding:3px 7px;border-radius:6px}
.arr{animation:fade .5s ease-out both}
@keyframes fade{from{opacity:0}to{opacity:1}}
.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:11px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:5px}
.legend i{display:inline-block;width:20px;height:0;border-top:2px solid #d9a800}
.legend i.run{border-top:2px dashed var(--muted)}
.legend i.dr{border-top:2px dotted var(--muted)}
.legend i.op{border-top:2px dashed #e26b6b}
.legend b{width:10px;height:10px;border-radius:50%;background:#d93535;display:inline-block}
.legend b.us{background:#2f6bf0}
.info{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:12px;min-height:54px}
.info strong{font-weight:600}
.muted{color:var(--muted)}
.panel{display:flex;flex-direction:column;gap:12px;min-width:0}
.tag{font:600 10.5px var(--f-body);text-transform:uppercase;letter-spacing:.08em;color:var(--accent)}
.panel h2{font-family:var(--f-display);font-size:15px;margin:2px 0 0}
.intro{margin:0;color:var(--muted);font-size:12.5px;max-width:64ch}
.controls{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.btn{font:600 12px var(--f-body);border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:7px;padding:7px 12px;cursor:pointer}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;min-width:96px}
.btn:disabled{opacity:.4;cursor:default}
select{font:500 12px var(--f-body);padding:6px 8px;border-radius:7px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
.count{font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums;margin-left:auto}
ol.steps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
ol.steps li button{all:unset;box-sizing:border-box;display:grid;grid-template-columns:18px 1fr;gap:8px;width:100%;padding:7px 10px;border-radius:7px;cursor:pointer;font-size:12.3px;color:var(--muted);border:1px solid transparent}
ol.steps li button:focus-visible{outline:2px solid var(--accent)}
ol.steps li button .k{font:700 11px var(--f-body);color:var(--muted);font-variant-numeric:tabular-nums;padding-top:1px}
ol.steps li.on button{background:var(--accent-soft);color:var(--ink);border-color:var(--accent)}
ol.steps li.on button .k{color:var(--accent)}
.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px}
.note{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:9px 12px;font-size:11.8px;min-width:0}
.note h4{margin:0 0 4px;font:600 10.5px var(--f-body);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.note.bad h4{color:var(--bad)}
.note.good h4{color:var(--good)}
.note ul{margin:0;padding-left:15px;display:flex;flex-direction:column;gap:2px}
.calls{display:flex;flex-wrap:wrap;gap:4px}
.call{font:600 11px var(--f-body);padding:2px 7px;border-radius:5px;background:var(--accent-soft);color:var(--accent)}
section h3{font:600 12px var(--f-body);text-transform:uppercase;letter-spacing:.07em;margin:0 0 8px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px;cursor:pointer;text-align:left;font:inherit;color:inherit}
.card.sel{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
.card .top{display:flex;gap:8px;align-items:center}
.card .num{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#2557d6;color:#fff;font:700 10.5px var(--f-body);flex:none}
.card .num.gk{background:#e08a00}
.card .nm{font-weight:600;font-size:12.5px}
.card .pos{font-size:11px;color:var(--muted)}
.card .pos b{color:var(--ink);font-weight:600}
.card dl{margin:0;display:grid;grid-template-columns:62px 1fr;gap:3px 8px;font-size:11.3px}
.card dt{color:var(--muted);font-weight:600}
.card dd{margin:0}
.card .key{font-size:11px;color:var(--accent);font-weight:600}
.plan{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.plan .note{font-size:12px}
.glossary{display:flex;flex-direction:column;gap:5px;font-size:12px}
.glossary div{display:grid;grid-template-columns:130px 1fr;gap:8px}
@media (max-width:520px){.glossary div{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){.pl,.opp,.ball{transition-duration:.01s!important}.arr{animation:none}}
</style>

<div class="wrap">
  <header>
    <h1>Схема 4-2-1 → 3-3-1</h1>
    <p class="sub">Формат 8 на 8. Без мяча стоим 4-2-1, с мячом Асланбек выходит в центр поля и команда играет 3-3-1. У соперника на поле тоже 8 игроков, включая вратаря. Атакуем вверх.</p>
  </header>

  <div class="groups" id="groups"></div>

  <div class="main">
    <div class="board">
      <div class="pitch" id="pitch">
        <svg viewBox="0 0 68 100" aria-hidden="true">
          <defs>
            <marker id="mk-pass" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="2.6" markerHeight="2.6" markerUnits="userSpaceOnUse" orient="auto"><path d="M0,0L10,5L0,10z" fill="#ffd23f"/></marker>
            <marker id="mk-run" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="2.4" markerHeight="2.4" markerUnits="userSpaceOnUse" orient="auto"><path d="M0,0L10,5L0,10z" fill="#ffffff"/></marker>
            <marker id="mk-opp" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="2.4" markerHeight="2.4" markerUnits="userSpaceOnUse" orient="auto"><path d="M0,0L10,5L0,10z" fill="#ff8a8a"/></marker>
          </defs>
          <g fill="none" stroke="rgba(255,255,255,.85)" stroke-width=".35">
            <rect x="1.5" y="1.5" width="65" height="97"/>
            <line x1="1.5" y1="50" x2="66.5" y2="50"/>
            <circle cx="34" cy="50" r="8"/>
            <rect x="14" y="1.5" width="40" height="15"/>
            <rect x="24" y="1.5" width="20" height="5.5"/>
            <rect x="14" y="83.5" width="40" height="15"/>
            <rect x="24" y="93" width="20" height="5.5"/>
            <rect x="29" y=".2" width="10" height="1.3" fill="rgba(255,255,255,.25)"/>
            <rect x="29" y="98.5" width="10" height="1.3" fill="rgba(255,255,255,.25)"/>
          </g>
          <g fill="#fff"><circle cx="34" cy="50" r=".5"/><circle cx="34" cy="11.5" r=".45"/><circle cx="34" cy="88.5" r=".45"/></g>
          <g id="arrows"></g>
        </svg>
        <div class="shape" id="shape">4-2-1</div>
        <div class="dir">атака ↑</div>
      </div>
      <div class="legend">
        <span><b class="us"></b>мы (8)</span>
        <span><b></b>соперник (8)</span>
        <span><i></i>пас / удар</span>
        <span><i class="run"></i>движение</span>
        <span><i class="dr"></i>ведение</span>
        <span><i class="op"></i>пас соперника</span>
      </div>
      <div class="info" id="info"><span class="muted">Нажми на игрока на поле, чтобы увидеть его роль.</span></div>
    </div>

    <div class="panel">
      <div>
        <div class="tag" id="tag"></div>
        <h2 id="title"></h2>
      </div>
      <p class="intro" id="intro"></p>
      <div class="controls">
        <button class="btn" id="restart" type="button">⟲ Сначала</button>
        <button class="btn" id="prev" type="button" aria-label="Шаг назад">◀</button>
        <button class="btn primary" id="play" type="button">▶ Играть</button>
        <button class="btn" id="next" type="button" aria-label="Шаг вперёд">▶▶</button>
        <select id="speed" aria-label="Скорость">
          <option value="0.6">Медленно</option>
          <option value="1" selected>Обычно</option>
          <option value="1.5">Быстро</option>
        </select>
        <span class="count" id="count"></span>
      </div>
      <ol class="steps" id="steps"></ol>
      <div class="notes" id="notes"></div>
    </div>
  </div>

  <section>
    <h3>Роль каждого игрока по фазам</h3>
    <div class="grid" id="roles"></div>
  </section>

  <section>
    <h3>Установка на матч</h3>
    <div class="plan">
      <div class="note good"><h4>Расстояния</h4><ul>
        <li>Между линиями 10–12 м, вся команда в 30–35 м по длине.</li>
        <li>Без мяча — узко: между защитниками 8–10 м.</li>
        <li>С мячом — широко: Умар и Джабраил у самых бровок.</li>
        <li>Вратарь в 4-2-1 — на 10–15 м от ворот, в 3-3-1 — у края штрафной.</li>
      </ul></div>
      <div class="note"><h4>Первые 10 минут</h4><ul>
        <li>Высокий прессинг после каждого удара от ворот соперника.</li>
        <li>Проверяем их крайних защитников: кто слабее в обводке — туда атакуем.</li>
        <li>Без риска в своей штрафной: сомневаешься — длинно на Самада.</li>
      </ul></div>
      <div class="note"><h4>Ведём в счёте</h4><ul>
        <li>Асланбек чаще остаётся в линии — атакуем 4-2-1 (четыре сзади).</li>
        <li>Прессингуем только в своей половине, блок ниже.</li>
        <li>Последние минуты — держим мяч у углового флага соперника.</li>
        <li>Не фолим у своей штрафной: стандарт для них — лучший шанс.</li>
      </ul></div>
      <div class="note"><h4>Проигрываем</h4><ul>
        <li>3-3-1 постоянно, Булат или Иса поднимается выше (вторым вингером).</li>
        <li>Вратарь играет выше как восьмой полевой.</li>
        <li>Быстрый ввод мяча: аут и удар от ворот — без пауз.</li>
        <li>Больше навесов и подборов: Асланбек подключается к штрафной.</li>
      </ul></div>
      <div class="note"><h4>Замены</h4><ul>
        <li>Больше всех бегают Асланбек, Умар и Джабраил — их меняем первыми.</li>
        <li>Свежий игрок выходит на фланг: там больше всего рывков.</li>
        <li>Замена — во время остановки, сменщик знает свою роль заранее.</li>
      </ul></div>
      <div class="note"><h4>Привычки каждого</h4><ul>
        <li>До приёма мяча посмотреть через плечо.</li>
        <li>Принимать открытым корпусом, в сторону от соперника.</li>
        <li>Отдал пас — двигайся, создай новый треугольник.</li>
        <li>Говорить постоянно: молчащая команда пропускает.</li>
      </ul></div>
    </div>
  </section>

  <section>
    <h3>Команды на поле</h3>
    <div class="note glossary">
      <div><span class="call">«Тройка!»</span><span>Мяч наш — перестраиваемся в 3-3-1, Асланбек выходит в центр.</span></div>
      <div><span class="call">«Четвёрка!»</span><span>Мяч потерян — назад в 4-2-1, Асланбек в пару к Анвару.</span></div>
      <div><span class="call">«Жми!»</span><span>Сигнал прессинга: ближайший идёт на мяч, остальные закрывают передачи.</span></div>
      <div><span class="call">«Выход!»</span><span>Линия обороны поднимается вместе (после выноса, после паса соперника назад).</span></div>
      <div><span class="call">«Держим!»</span><span>Не выходить в отбор, стоять и закрывать ворота.</span></div>
      <div><span class="call">«Человек!»</span><span>За спиной соперник — играй в одно касание.</span></div>
      <div><span class="call">«Время!»</span><span>Рядом никого — принимай, разворачивайся.</span></div>
      <div><span class="call">«Меняй!»</span><span>Переводим мяч на другой фланг.</span></div>
      <div><span class="call">«Мой!»</span><span>Вратарь забирает мяч, все уходят с пути.</span></div>
    </div>
  </section>
</div>

<script>
const PL=[
 {id:'p4',n:'4',s:'Вратарь',full:'Вратарь',gk:true,r1:'вратарь',r2:'вратарь у края штрафной',key:'Голос команды и игра ногами',
  ph:{'Без мяча':'Руководит линией: «Выход!», «Держим!», «Человек!». В 4-2-1 стоит в 10–15 м от ворот.',
      'С мячом':'Коротко Асланбеку или Анвару в дальнюю от соперника ногу. Под прессингом — длинно в зону Самада, не в центр.',
      'Потеря':'Выходит на передачи за спину защитникам, играет как последний защитник.',
      'Стандарты':'На угловых соперника забирает всё во вратарской с криком «Мой!». На наших угловых стоит у центра поля.'}},
 {id:'p21',n:'21',s:'Иса',full:'Тимаев Иса',r1:'левый защитник',r2:'левый из трёх защитников',key:'Дисциплина и стойка боком',
  ph:{'Без мяча':'Пас соперника на его фланг — сигнал: выходит в упор, ведёт к бровке, внутрь не пускает. При атаке справа сужается к Анвару.',
      'С мячом':'Пас вдоль бровки Умару. Перекрывает по флангу, только когда Асланбек может встать на его место.',
      'Потеря':'Остаётся в тройке, далеко в прессинг не бежит.',
      'Стандарты':'На угловых соперника — ближняя штанга. На наших — страхует против их нападающего.'}},
 {id:'p95',n:'95',s:'Анвар',full:'Анвар Висалиев',r1:'центральный защитник',r2:'центральный из трёх, последний',key:'Спокойствие и игра головой',
  ph:{'Без мяча':'Лидер линии: держит её ровной, выигрывает верховые мячи у нападающего.',
      'С мячом':'Смещается в центр тройки. Первый пас — Асланбеку или крайним. В своей зоне не обводит никогда.',
      'Потеря':'Не бросается в отбор, задерживает нападающего и даёт команде вернуться.',
      'Стандарты':'На угловых соперника — зона в центре вратарской. На наших — забегает на дальнюю штангу.'}},
 {id:'p9',n:'9',s:'Асланбек',full:'Асланбек',r1:'центральный защитник',r2:'опорный полузащитник',key:'Выносливость и обзор',
  ph:{'Без мяча':'В паре с Анваром. На высоком прессинге выходит на их опорника.',
      'С мячом':'Главный переключатель: выходит в центр поля, получает лицом к воротам, переводит фланги, страхует, когда Иса или Булат идут вперёд.',
      'Потеря':'«Четвёрка!» — первым возвращается в пару к Анвару.',
      'Стандарты':'На угловых соперника опекает их лучшего игрока на втором этаже. На наших — главная цель подачи, забегает в центр из-за спины.'}},
 {id:'p6',n:'6',s:'Булат',full:'Булат',r1:'правый защитник',r2:'правый из трёх защитников',key:'Чтение игры и перехваты',
  ph:{'Без мяча':'Пас соперника на его фланг — выходит в упор и ведёт к бровке. При атаке слева сужается к центру.',
