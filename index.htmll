 {ball:[52,1],arrows:[['shot',62,12,52,1.5]],
  text:'Удар или пас Умару на дальнюю. Асланбек на подборе, тройка страхует у центра поля.',focus:['p11','p9']}
 ]},
{id:'switch',g:'С мячом',title:'Смена фланга',tag:'Атака 3-3-1',shape:'3-3-1',
 start:M(A,{p10:[12,36],p21:[18,64],p9:[40,48],p95:[44,70],p6:[74,64],p5:[44,20],p11:[88,38]}),ball:'p21',
 opp:[[50,4],[22,18],[40,20],[60,18],[16,32],[34,34],[58,34],[36,50]],
 intro:'Соперник сместился к мячу — переводим на другой фланг за два паса, и Джабраил получает один на один.',
 notes:{when:['На фланге с мячом трое соперников, на другом — один.'],calls:['Меняй!','Время!'],
  bad:['Перевод в 4–5 касаний: соперник успевает сместиться.','Джабраил стоит в центре, а не у бровки.','Перевод одним длинным мячом через центр.']},
 steps:[
 {text:'Атакуем слева, соперник сместился к мячу. У Джабраила справа свободно. Асланбек кричит «Меняй!».',focus:['p11','p6','p9']},
 {ball:'p9',arrows:[['pass',18,64,40,48]],text:'Иса — Асланбеку. Асланбек заранее раскрыл корпус вправо.',focus:['p21','p9']},
 {ball:'p6',opp:[[50,4],[26,18],[44,20],[64,18],[22,32],[40,34],[64,34],[42,50]],arrows:[['pass',40,48,74,64]],
  text:'В одно касание Булату. Два паса — и мяч на другом фланге.',focus:['p9','p6']},
 {ball:'p11',opp:[[50,4],[30,18],[48,20],[76,24],[26,34],[46,36],[70,34],[46,50]],arrows:[['pass',74,64,88,38]],
  text:'Булат — Джабраилу. Он один на один, и у него есть время: идёт в обводку.',focus:['p6','p11']},
 {pos:{p11:[86,14],p5:[46,8],p10:[34,12],p9:[54,30]},opp:[[50,3],[40,8],[52,10],[80,16],[30,20],[54,24],[72,30],[46,48]],
  arrows:[['drib',88,38,86,14],['run',44,20,46,8],['run',12,36,34,12],['run',40,48,54,30]],
  text:'Джабраил обыгрывает и выходит к лицевой. Самад — ближняя, Умар — дальняя, Асланбек — на подбор.',focus:['p11','p5','p10','p9']},
 {ball:'p10',arrows:[['pass',86,14,34,12]],text:'Подача на дальнюю — Умар.',focus:['p11','p10']},
 {ball:[44,1],arrows:[['shot',34,12,44,1.5]],text:'Удар в одно касание.',focus:['p10']}
 ]},
/* ---------- СТАНДАРТЫ ---------- */
{id:'cornerA',g:'Стандарты',title:'Наш угловой',tag:'Стандарт в атаке',shape:'угловой',
 start:{p11:[97,3],p5:[50,18],p9:[64,22],p95:[40,22],p10:[36,28],p21:[30,52],p6:[70,52],p4:[50,72]},ball:[97,2],
 opp:[[50,3],[86,6],[44,6],[54,6],[64,19],[42,19],[52,17],[52,46]],
 intro:'Трое в штрафной, Умар на подборе, двое страхуют против их нападающего, вратарь выше.',
 notes:{when:['Подающий поднимает руку — сигнал к забеганиям.'],calls:['Мой!','Выход!'],
  bad:['Все стоят на месте в ожидании подачи.','Подача в руки вратарю во вратарскую.','После углового защитники не возвращаются бегом.'],
  plan:['Короткий вариант: Булат подходит к флагу, Джабраил даёт ему и получает обратно ближе к штрафной.']},
 steps:[
 {text:'Подаёт Джабраил. Самад, Асланбек и Анвар в штрафной, Умар на краю на отскок. Иса и Булат вдвоём против их нападающего, вратарь у центра.',focus:['p11','p5','p9','p95','p10']},
 {pos:{p5:[42,7],p95:[62,10],p9:[54,9]},opp:[[50,3],[86,6],[44,6],[54,6],[60,13],[46,11],[56,13],[52,46]],
  arrows:[['run',50,18,42,7],['run',40,22,62,10],['run',64,22,54,9]],
  text:'Самад срывается на ближнюю и уводит защитника, Анвар — на дальнюю. Асланбек забегает в центр из-за спины опекуна.',focus:['p5','p95','p9']},
 {ball:'p9',arrows:[['pass',97,2,54,9]],text:'Подача между вратарской и 11-метровой: вратарь не достаёт, защитники бегут назад.',focus:['p11','p9']},
 {ball:[52,1],arrows:[['shot',54,9,52,1.5]],text:'Удар головой. Умар добивает отскок с края штрафной.',focus:['p9','p10']}
 ]},
{id:'cornerD',g:'Стандарты',title:'Угловой соперника',tag:'Стандарт в обороне',shape:'угловой',
 start:{p4:[50,96],p21:[42,96],p95:[50,90],p9:[58,88],p6:[64,86],p10:[42,80],p11:[12,90],p5:[50,62]},ball:[2,98],
 opp:[[50,6],[2,99],[14,94],[50,86],[58,84],[64,82],[44,77],[56,48]],
 intro:'Смешанная защита: Иса и Анвар держат зоны, Асланбек и Булат опекают лучших головой, Самад ждёт контратаку.',
 notes:{when:['Угловой или навесной штрафной соперника.'],calls:['Мой!','Выход!'],
  bad:['Выносим мяч в центр, прямо под удар.','Защитник смотрит только на мяч и теряет игрока.','После выноса остаёмся в штрафной.']},
 steps:[
 {text:'Иса — ближняя штанга, Анвар — зона в центре. Асланбек и Булат опекают лучших головой, Джабраил закрывает короткий розыгрыш, Умар — край штрафной. Самад у центра держит их защитника.',focus:['p21','p95','p9','p6','p11','p10','p5']},
 {ball:'p9',opp:[[50,6],[2,99],[14,94],[48,89],[58,87],[66,86],[44,80],[56,48]],arrows:[['pass',2,98,57,88]],
  text:'Подача. Асланбек атакует мяч первым, в прыжке, и выносит высоко и в сторону.',focus:['p9']},
 {ball:'p10',pos:{p10:[34,72]},arrows:[['pass',58,88,34,72],['run',42,80,34,72]],
  text:'Мяч у Умара. Сразу вперёд: соперник оставил сзади одного защитника.',focus:['p10']},
 {ball:'p5',pos:{p5:[46,50],p95:[50,78],p21:[34,82],p6:[66,80],p9:[56,76]},opp:[[50,6],[8,92],[18,86],[46,84],[58,84],[64,80],[40,76],[62,46]],
  arrows:[['pass',34,72,46,51],['run',50,62,46,50],['run',50,90,50,78],['run',42,96,34,82],['run',64,86,66,80],['run',58,88,56,76]],
  text:'Пас Самаду — он один против одного. Защитники по команде «Выход!» выбегают из штрафной, чтобы соперник не добил второй мяч.',focus:['p5','p95','p21','p6','p9']}
 ]}
];

const pitch=document.getElementById('pitch'),arrowsG=document.getElementById('arrows');
const els={};
PL.forEach(p=>{
  const b=document.createElement('button');b.type='button';b.className='pl'+(p.gk?' gk':'');
  b.setAttribute('aria-label',p.full+', '+p.r1);
  b.innerHTML='<span class="c">'+p.n+'</span><span class="n">'+p.s+'</span>';
  b.onclick=()=>select(p.id);pitch.appendChild(b);els[p.id]=b;
});
const opps=[];for(let i=0;i<8;i++){const o=document.createElement('div');o.className='opp'+(i===0?' gk':'');pitch.appendChild(o);opps.push(o)}
const ball=document.createElement('div');ball.className='ball';ball.textContent='⚽';pitch.appendChild(ball);

const rolesEl=document.getElementById('roles');const cards={};
PL.forEach(p=>{
  const c=document.createElement('button');c.type='button';c.className='card';
  c.innerHTML='<div class="top"><span class="num'+(p.gk?' gk':'')+'">'+p.n+'</span><span class="nm">'+p.full+'</span></div>'+
   '<div class="pos">4-2-1: <b>'+p.r1+'</b> · 3-3-1: <b>'+p.r2+'</b></div><dl>'+
   Object.entries(p.ph).map(([k,v])=>'<dt>'+k+'</dt><dd>'+v+'</dd>').join('')+'</dl><div class="key">Главное: '+p.key+'</div>';
  c.onclick=()=>select(p.id);rolesEl.appendChild(c);cards[p.id]=c;
});

let sel=null;
function select(id){
  sel=sel===id?null:id;
  PL.forEach(p=>{els[p.id].classList.toggle('sel',p.id===sel);cards[p.id].classList.toggle('sel',p.id===sel)});
  const info=document.getElementById('info');
  if(!sel){info.innerHTML='<span class="muted">Нажми на игрока на поле, чтобы увидеть его роль.</span>';return}
  const p=PL.find(x=>x.id===sel),g=SC[sc].g;
  const phase=g==='Стандарты'?'Стандарты':g==='Без мяча'?'Без мяча':SC[sc].id==='loss'?'Потеря':'С мячом';
  info.innerHTML='<strong>№'+p.n+' '+p.full+'</strong> <span class="muted">· 4-2-1: '+p.r1+' · 3-3-1: '+p.r2+'</span><br><span class="muted">'+phase+':</span> '+p.ph[phase];
}

let sc=0,step=-1,timer=null,playing=false;
const groupsEl=document.getElementById('groups'),chipEls=[];
['Переходы','Без мяча','С мячом','Стандарты'].forEach(g=>{
  const row=document.createElement('div');row.className='grp';row.setAttribute('role','group');row.setAttribute('aria-label',g);
  row.innerHTML='<span class="gl">'+g+'</span>';
  SC.forEach((s,i)=>{if(s.g!==g)return;const b=document.createElement('button');b.type='button';b.className='chip';b.textContent=s.title;b.onclick=()=>loadSc(i,true);row.appendChild(b);chipEls[i]=b});
  groupsEl.appendChild(row);
});

function stateAt(s,k){
  const pos=Object.assign({},s.start);let ball=s.ball,opp=s.opp,shape=s.shape,arrows=[],focus=null;
  for(let i=0;i<=k;i++){const st=s.steps[i];if(st.pos)Object.assign(pos,st.pos);if('ball' in st)ball=st.ball;if(st.opp)opp=st.opp;if(st.shape)shape=st.shape;arrows=st.arrows||[];focus=st.focus||null}
  return{pos,ball,opp,shape,arrows,focus};
}
const X=x=>x*0.68;
function arrowSvg(a){
  const[t,x1,y1,x2,y2]=a;let ax=X(x1),ay=y1,bx=X(x2),by=y2;
  const dx=bx-ax,dy=by-ay,L=Math.hypot(dx,dy);
  if(L>4&&t!=='shot'){const c=2.1/L;bx-=dx*c;by-=dy*c}
  if(L>4){const c=1.5/L;ax+=dx*c;ay+=dy*c}
  const st={pass:'stroke="#ffd23f" stroke-width=".45" marker-end="url(#mk-pass)"',
   shot:'stroke="#ffd23f" stroke-width=".7" marker-end="url(#mk-pass)"',
   run:'stroke="#fff" stroke-width=".33" stroke-dasharray="1.2 .9" marker-end="url(#mk-run)"',
   drib:'stroke="#fff" stroke-width=".42" stroke-dasharray=".2 .8" stroke-linecap="round" marker-end="url(#mk-run)"',
   opp:'stroke="#ff8a8a" stroke-width=".35" stroke-dasharray="1 .8" marker-end="url(#mk-opp)"'}[t];
  return '<line class="arr" x1="'+ax.toFixed(2)+'" y1="'+ay.toFixed(2)+'" x2="'+bx.toFixed(2)+'" y2="'+by.toFixed(2)+'" '+st+'/>';
}
function render(instant){
  const s=SC[sc],S=stateAt(s,step);
  if(instant)pitch.classList.add('notrans');
  PL.forEach(p=>{const e=els[p.id],[x,y]=S.pos[p.id];e.style.left=x+'%';e.style.top=y+'%';
    e.classList.toggle('dim',!!S.focus&&!S.focus.includes(p.id))});
  opps.forEach((o,i)=>{const q=S.opp[i];o.style.left=q[0]+'%';o.style.top=q[1]+'%'});
  if(typeof S.ball==='string'){const[x,y]=S.pos[S.ball];ball.style.left=x+'%';ball.style.top=y+'%';ball.classList.add('held')}
  else{ball.style.left=S.ball[0]+'%';ball.style.top=S.ball[1]+'%';ball.classList.remove('held')}
  arrowsG.innerHTML=S.arrows.map(arrowSvg).join('');
  document.getElementById('shape').textContent=S.shape;
  document.querySelectorAll('#steps li').forEach((li,i)=>li.classList.toggle('on',i===step));
  document.getElementById('count').textContent=step<0?'Старт':'Шаг '+(step+1)+' из '+s.steps.length;
  document.getElementById('prev').disabled=step<0;
  document.getElementById('next').disabled=step>=s.steps.length-1;
  if(instant){void pitch.offsetWidth;pitch.classList.remove('notrans')}
}
function list(a){return '<ul>'+a.map(x=>'<li>'+x+'</li>').join('')+'</ul>'}
function loadSc(i,auto){
  stop();sc=i;step=-1;const s=SC[i];
  chipEls.forEach((c,j)=>c&&c.setAttribute('aria-pressed',j===i));
  document.getElementById('tag').textContent=s.g+' · '+s.tag;
  document.getElementById('title').textContent=s.title;
  document.getElementById('intro').textContent=s.intro;
  const ol=document.getElementById('steps');ol.innerHTML='';
  s.steps.forEach((st,k)=>{const li=document.createElement('li');const b=document.createElement('button');b.type='button';
    b.innerHTML='<span class="k">'+(k+1)+'</span><span>'+st.text+'</span>';b.onclick=()=>{stop();step=k;render(false)};li.appendChild(b);ol.appendChild(li)});
  const n=s.notes;
  document.getElementById('notes').innerHTML=
    '<div class="note good"><h4>Когда</h4>'+list(n.when)+'</div>'+
    '<div class="note"><h4>Команды</h4><div class="calls">'+n.calls.map(c=>'<span class="call">«'+c+'»</span>').join('')+'</div>'+(n.plan?'<h4 style="margin-top:8px">План Б</h4>'+list(n.plan):'')+'</div>'+
    '<div class="note bad"><h4>Ошибки</h4>'+list(n.bad)+'</div>';
  render(true);
  if(sel){const k=sel;sel=null;select(k)}
  if(auto)play();
}
function dur(){return 3000/parseFloat(document.getElementById('speed').value)}
function tick(){const n=SC[sc].steps.length;if(step<n-1){step++;render(false);timer=setTimeout(tick,dur())}else stop()}
function play(){
  if(step>=SC[sc].steps.length-1){step=-1;render(true)}
  playing=true;document.getElementById('play').textContent='❚❚ Пауза';
  timer=setTimeout(tick,step<0?700:200);
}
function stop(){clearTimeout(timer);playing=false;document.getElementById('play').textContent='▶ Играть'}
document.getElementById('play').onclick=()=>playing?stop():play();
document.getElementById('restart').onclick=()=>{stop();step=-1;render(true)};
document.getElementById('prev').onclick=()=>{stop();if(step>-1){step--;render(false)}};
document.getElementById('next').onclick=()=>{stop();if(step<SC[sc].steps.length-1){step++;render(false)}};

loadSc(0,!matchMedia('(prefers-reduced-motion: reduce)').matches);
</script>

</body></html>
