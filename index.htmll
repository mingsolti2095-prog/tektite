  arrows:[['pass',20,66,12,40],['run',50,48,34,46]],
  text:'Иса — Умару в ноги. Асланбек подходит ближе: треугольник Иса–Умар–Асланбек.',focus:['p21','p10','p9']},
 {ball:'p21',pos:{p10:[22,36],p21:[12,24],p9:[24,62]},opp:[[50,4],[22,20],[44,19],[64,17],[24,38],[42,34],[68,32],[36,50]],
  arrows:[['drib',12,40,22,36],['run',20,66,12,24],['pass',22,36,12,24],['run',34,46,24,62]],
